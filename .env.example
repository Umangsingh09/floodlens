# FloodLens project configuration
# Copy this file to .env and populate the values for your environment.

REGION_NAME=bihar-nepal
AOI_NAME=Bihar + Nepal Terai
AOI_GEOJSON={"type":"Polygon","coordinates":[[[83.5,26.2],[88.2,26.2],[88.2,28.8],[83.5,28.8],[83.5,26.2]]]}
START_DATE=2016-01-01
END_DATE=2024-12-31
SATELLITE_PROVIDER=google-earth-engine
SATELLITE_COLLECTION=COPERNICUS/S1_GRD
SENTINEL1_INSTRUMENT_MODE=IW
SENTINEL1_POLARIZATIONS=VV,VH
PREDICTION_HORIZON_DAYS=7
MODEL_TYPE=logistic_regression
RISK_THRESHOLD=0.7
DEM_ENABLED=false
DATA_DIR=ai/data
OUTPUT_DIR=ai/outputs
EARTHENGINE_PROJECT=

# Optional: Earth Engine project for new GEE Python API versions.
# To authenticate locally:
#   python -m pip install earthengine-api
#   earthengine authenticate
