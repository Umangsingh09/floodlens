# All variables are optional; sensible defaults are used when unset.
FLOODLENS_APP_NAME=FloodLens API
FLOODLENS_APP_VERSION=0.1.0
FLOODLENS_CORS_ALLOW_ORIGINS=["http://localhost:5173"]

# --- Production deployment (e.g. Render) ---
# For CORS, list every real frontend origin — e.g.:
# FLOODLENS_CORS_ALLOW_ORIGINS=["https://your-app.vercel.app","http://localhost:5173"]

# Earth Engine project (same one used locally — see ai/README.md).
# EARTHENGINE_PROJECT=your-project-id

# A server can't run the interactive `earthengine authenticate` browser flow, so it
# authenticates instead with a Google Cloud service account key (see
# https://developers.google.com/earth-engine/guides/service_account). Paste the full
# downloaded JSON key as the value of ONE of these two:
#   GOOGLE_APPLICATION_CREDENTIALS  — a file path (use Render's "Secret Files" to mount one)
#   GOOGLE_SERVICE_ACCOUNT_KEY      — the raw JSON content, as a single-line env var
# Not needed for local development — that keeps using your `earthengine authenticate` login.
# GOOGLE_SERVICE_ACCOUNT_KEY={"type":"service_account","client_email":"...","private_key":"...", ...}
